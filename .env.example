# ==============================================================================
# MORNYE NETWORK STORAGE — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and customize for your deployment environment.
# ==============================================================================

# Application Environment
APP_NAME="Mornye Network Storage"
APP_ENV=production
DEBUG=false

# Core Security
# Replace with a cryptographically secure 64-character hex string
SECRET_KEY=change-this-to-a-secure-random-64-character-hex-key-in-production

# Network Bindings
MORNYE_HOST_BIND=127.0.0.1
MORNYE_HOST_PORT=8001
WEBDAV_HOST=127.0.0.1
WEBDAV_PORT=8000

# Storage Quotas (100 GB default)
# 100 GB = 107,374,182,400 bytes
DEFAULT_STORAGE_QUOTA_BYTES=107374182400
MAX_UPLOAD_SIZE_BYTES=2147483648

# Domain Configuration
STORAGE_HOSTNAME=storage.example.com
PUBLIC_DOMAIN=example.com

# Optional Database URL override
# DATABASE_URL=sqlite+aiosqlite:///database/mornye.db
